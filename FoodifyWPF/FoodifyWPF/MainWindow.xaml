<Window x:Class="FoodifyWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FoodifyWPF"
        mc:Ignorable="d"
        Title="Foodify Karbantartó" Height="450" Width="800">
    <Grid>
        <Menu>
            <MenuItem Header="Bejelentkezés" 
                      Click="OpenLoginWindow_Click"
                      Name="mitemBejelentkezes"/>

            <MenuItem Header="Kilépés" 
                      Click="Kilepes_Click"
                      Name="miteKijelentkezes"
                      Visibility="Collapsed"/>

            <MenuItem Header="Felhasználók"
                      IsEnabled="False"
                      Name="mitemFelhasznalok">
                
                <MenuItem Header="Felhasználók listázása" Click="UserListWindow_Click"/>
                <MenuItem Header="Felhasználók rögzítése" Click="NewUserWindow_Click"/>
                <MenuItem Header="Felhasználók módosítás" Click="UserModify_Click"/>
            </MenuItem>
            
            <MenuItem Header="Éttermek"
                      IsEnabled="False"
                      Name="mitemRestaurant">
                <MenuItem Header="Éttermek listázása" Click="RestaurantList_Click"/>
                <MenuItem Header="Éttermek rögzítése" Click="NewRestaurant_Click"/>
                <MenuItem Header="Éttermek módosítás" Click="ModifyRestaurant_Click"/>
            </MenuItem>

            <MenuItem Header="Menü"
                      IsEnabled="False"
                      Name="mitMenu">
                <MenuItem Header="Menü listázása" Click="MenuLista_Click"/>
                <MenuItem Header="Menü rögzítése" Click="MenuAdd_Click"/>
                <MenuItem Header="Menü módosítás" Click="MenuModify_Click"/>
            </MenuItem>
        </Menu>
    </Grid>
</Window>
